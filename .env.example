# Documentation only: the app DOES NOT automatically read .env.
# Set environment variables in your shell before starting python run.py.
# Leave URLs empty for deterministic-only operation (no AI requests).
REMOTE_AI_URL=
REMOTE_AI_KEY=
REMOTE_AI_MODEL=
LOCAL_AI_URL=
LOCAL_AI_MODEL=local
# Example local URL: http://127.0.0.1:8080/v1/chat/completions
# Remote requests additionally require explicit per-analysis UI consent.
